# Copiá este archivo a ".env" y completá con tus valores reales.
# NUNCA subas el ".env" real a git ni lo compartas en un zip.

PORT=3000

# Meta WhatsApp Cloud API (developers.facebook.com)
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notificaciones push (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
