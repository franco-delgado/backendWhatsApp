# Copiá este archivo a ".env" y completá con tus valores reales.
# NUNCA subas el ".env" real a git ni lo compartas en un zip.

PORT=3000

# Meta WhatsApp Cloud API (developers.facebook.com)
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notificaciones push (generar con: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Minutos que el bot de IA queda callado en una conversación después de que
# vos contestás a mano (por defecto 60).
IA_PAUSA_MINUTOS=60

# --- Usuarios / login ---
# Firma de las sesiones. Poné una cadena larga y aleatoria (si falta, se deriva de SUPABASE_SERVICE_ROLE_KEY).
AUTH_SECRET=
# Administrador que se crea la primera vez que arranca el servidor
# (por defecto FRANCO / 232015). Cambiá la clave desde la app después de entrar.
ADMIN_USER=FRANCO
ADMIN_PASSWORD=232015
